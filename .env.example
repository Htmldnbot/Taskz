# Supabase Configuration for Taskz Android Application
# Provide your Supabase project URL and anon public client key.
# Secrets can be placed in .env (which is git-ignored) or configured via AI Studio secrets.
# NEVER put the SUPABASE_SERVICE_ROLE_KEY in the Android application.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
