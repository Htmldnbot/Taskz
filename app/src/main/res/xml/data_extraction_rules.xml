<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude authentication tokens and sensitive credentials from Android cloud backup -->
        <exclude domain="file" path="datastore/taskz_secure_session.preferences_pb" />
        <exclude domain="sharedpref" path="taskz_auth_session.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude authentication tokens from device-to-device transfers -->
        <exclude domain="file" path="datastore/taskz_secure_session.preferences_pb" />
        <exclude domain="sharedpref" path="taskz_auth_session.xml" />
    </device-transfer>
</data-extraction-rules>
